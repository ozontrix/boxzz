# ─── Boxzz environment variables (sample) ─────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets (`.env*` is gitignored).

# Site URL
NEXT_PUBLIC_SITE_URL=https://boxzz.in

# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/<project-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (server-side only - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Payment Gateway (Online Mode)
# Get your test/live keys from: https://dashboard.razorpay.com/app/keys
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose to the browser.
# Test keys start with `rzp_test_`, live keys with `rzp_live_`.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
